{:id :tabs
 :title "Tabs"
 :summary "Switch between peer panels of one object, with no JS: hidden radios drive the panels."
 :category :disclosure
 :group "Navigation"
 :keywords ["tabs" "tab panel" "segmented" "underline tabs" "css only"]

 :when-to-use
 ["Peer panels of one object: Overview, Activity, Settings."
  "Content that should switch in place without a route change, on all targets including server-rendered hiccup."]

 :when-not-to-use
 ["Use button-group for two to five views of the same data (a range or a layout toggle)."
  "Use accordion for stacked sections that are read in order."
  "Use real links when each panel is its own page."]

 :usage "(require '[ui.tabs :as tabs])\n\n(tabs/tabs {:variant :line\n            :default \"account\"\n            :tabs [{:id \"account\"  :label \"Account\"  :content [:div \"...\"]}\n                   {:id \"password\" :label \"Password\" :content [:div \"...\"]}]})"

 :examples
 [{:title "Boxed segmented tabs with a fixed radio name"
   :code "(tabs/tabs {:name \"view\"\n            :tabs [{:id \"grid\" :label \"Grid\" :content grid}\n                   {:id \"list\" :label \"List\" :content list}]})"}]

 :api
 [{:fn "tabs"
   :doc "Renders a radio group of triggers and the matching panels. The active tab is uncontrolled; the browser tracks it."
   :props [{:name :variant :type ":boxed | :line" :default ":boxed" :doc ":boxed is a segmented control with a raised pill; :line is underlined tabs."}
           {:name :default :type "string | keyword" :doc "Id of the initially active tab; defaults to the first."}
           {:name :tabs :type "vector of {:id :label :content}" :doc "The tabs. :content is hiccup."}
           {:name :name :type "string" :doc "Radio group name. Auto-generated when omitted; pass one for deterministic markup (tests, SSR snapshots)."}
           {:name :class :type "string"} {:name :attrs :type "map" :doc "Attributes on the root element."}]}
  {:fn "tabs-classes" :doc "Class string for {:variant}."}
  {:fn "tabs-class-list" :doc "Vector form."}]

 :keyboard [["Arrow keys" "Move between tabs (native radio behavior)."] ["Tab" "Moves focus into and out of the tab list."]]

 :accessibility
 ["Triggers are labels for radio inputs; the focus ring is drawn on the label of the focused radio."
  "Panels are hidden with CSS :has(), so hidden content is not read."]

 :motion ["Trigger color and background change over --duration-fast; no sliding indicator."]

 :responsive ["The tab list wraps; keep labels short. For many tabs prefer a select on phones."]

 :targets
 {:clj "Works without JS. State is not observable server-side."
  :cljs "Uncontrolled: to react to the active tab, listen for change on the radios via :attrs or render your own triggers."
  :squint "Same as Replicant; pass :name to keep ids stable across re-renders."}

 :notes-for-ai
 ["Tabs need no state; do not add an active-tab atom unless you must react to changes."
  "For a range toggle (7d, 30d, 90d) use button-group, not tabs."]

 :related [:button-group :accordion :toolbar]}
