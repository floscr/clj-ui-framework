{:id :spinner
 :title "Spinner"
 :summary "An indeterminate loading indicator in four sizes: a stretching accent arc on a muted track."
 :category :feedback
 :group "Status"
 :keywords ["spinner" "loading" "indeterminate" "busy"]

 :when-to-use
 ["Short waits with no layout to reserve: inside a button, next to a label, in a toolbar."
  "Unknown duration."]

 :when-not-to-use
 ["Use skeleton to reserve space for content that is loading."
  "Use progress when the completion is known."
  "Prefer button :loading over placing a spinner next to a button."]

 :usage "(require '[ui.spinner :as spinner])\n\n(spinner/spinner {:size :sm})"

 :api
 [{:fn "spinner"
   :doc "A <span> with role=status and a Loading label. Recolor with the --spinner-arc (default accent) and --spinner-track (default bg-2) custom properties, the stroke with --spinner-w."
   :props [{:name :size :type ":xs | :sm | :md | :lg" :default ":md"}
           {:name :class :type "string"} {:name :attrs :type "map" :doc "Override aria-label with something specific."}]}
  {:fn "spinner-classes" :doc "Class string for {:size}."}
  {:fn "spinner-class-list" :doc "Vector form."}]

 :accessibility ["Announces Loading once via role=status; pass a specific aria-label when several spinners are on screen."]

 :motion ["Two arcs sweep on an eased curve so the arc stretches and shrinks while the whole spinner drifts; transform only, so it runs on the compositor."
          "Reduced motion drops the stretching sweep and keeps a steady rotation, so it still reads as busy."]

 :responsive ["Sizes are fixed; :sm fits inside a button, :lg centers in an empty region."]

 :targets
 {:clj "Static markup." :cljs ":class may be a vector." :squint "Static markup."}

 :notes-for-ai ["Inside a button use the button's :loading prop; it picks the right size and color."
                "Recolor through --spinner-arc and --spinner-track, never border colors: the arcs live on ::before and ::after."]

 :related [:skeleton :progress :button]}
