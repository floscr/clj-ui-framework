{:deps {tmux-dev/tmux-dev {:git/url "https://git.example.com/floscr/tmux-dev"
                           :git/sha "3d9e53bc38b818bfcee312065ded0aef83bdecf4"}}
 :paths ["src" "test" "dev/hiccup/src" "dev/shared/src" "scripts"]

 :tasks
 {:requires ([tmux-dev.core :as td]
             [tmux-dev.env :as env])
  :init (do
          (def port-hiccup    (env/number "PORT_HICCUP" 3003))
          (def port-replicant (env/number "PORT_REPLICANT" 3001))
          (def port-squint    (env/number "PORT_SQUINT" 3002))
          (def dev-config
            {:session "ui-dev"
             :windows [["hiccup"    (str "bb watch-theme & PORT=" port-hiccup " bb dev-hiccup")]
                       ["replicant" (str "PORT=" port-replicant " bb dev-replicant")]
                       ["squint"    (str "PORT=" port-squint " bb dev-squint")]]
             :print [(str "Hiccup:    http://localhost:" port-hiccup)
                     (str "Replicant: http://localhost:" port-replicant)
                     (str "Squint:    http://localhost:" port-squint)]}))

  build-theme
  {:doc "Generate dist/theme.css from tokens.edn and copy to dev targets"
   :requires ([ui.css.gen :as gen]
              [clojure.java.io :as io])
   :task (do (gen/build-theme! {:input "src/theme/tokens.edn"
                                :output "dist/theme.css"})
             (let [css (slurp "dist/theme.css")]
               (spit "dev/replicant/public/theme.css" css)
               (io/make-parents "dev/squint/public/theme.css")
               (spit "dev/squint/public/theme.css" css)
               (println "Copied theme.css to dev targets"))
             (let [adapter (slurp "dev/theme-adapter.js")]
               (spit "dev/replicant/public/theme-adapter.js" adapter)
               (spit "dev/squint/public/theme-adapter.js" adapter)
               (println "Copied theme-adapter.js to dev targets"))
             (let [lr (slurp "dev/css-live-reload.js")]
               (spit "dev/replicant/public/css-live-reload.js" lr)
               (spit "dev/squint/public/css-live-reload.js" lr)
               (println "Copied css-live-reload.js to dev targets")
             (when (.exists (io/file "dist/ui-runtime.js"))
               (let [rt (slurp "dist/ui-runtime.js")]
                 (spit "dev/replicant/public/ui-runtime.js" rt)
                 (spit "dev/squint/public/ui-runtime.js" rt)
                 (println "Copied ui-runtime.js to dev targets"))))
             (doseq [md (.listFiles (io/file "src/ui")
                          (reify java.io.FileFilter
                            (accept [_ f] (.endsWith (.getName f) ".md"))))]
               (spit (str "dev/squint/public/" (.getName md)) (slurp md)))
             (println "Copied component docs to dev/squint"))}

  build-js-runtime
  {:doc "Compile squint JS runtime (context menu etc.) into dist/ui-runtime.js"
   :task (do
           (println "Compiling squint runtime...")
           (let [root  (System/getProperty "user.dir")
                 bin   (str root "/dev/squint/node_modules/.bin/")
                 mods  (str root "/dev/squint/node_modules")]
             (shell {:dir "src/ui/js"}
                    (str bin "squint") "compile")
             (shell {:dir "src/ui/js"
                     :extra-env {"NODE_PATH" mods}}
                    (str bin "esbuild")
                    ".compiled/index.mjs"
                    "--bundle" "--format=iife"
                    (str "--outfile=" root "/dist/ui-runtime.js")))
           (spit "src/ui/ui-runtime.js" (slurp "dist/ui-runtime.js"))
           (println "Built dist/ui-runtime.js + src/ui/ui-runtime.js"))}

  build-replicant
  {:doc "Release build of the replicant demo (dev/replicant/prod/js/main.js)"
   :depends [build-theme ensure-npm]
   :task (shell {:dir "dev/replicant"} "npx" "shadow-cljs" "release" "release")}

  build-squint
  {:doc "Release build of the squint demo (dev/squint/dist/)"
   :depends [build-theme ensure-npm]
   :task (shell {:dir "dev/squint"} "npm" "run" "build")}

  build-demos
  {:doc "Release-build both SPA demos for the production server (/replicant, /squint)"
   :depends [build-replicant build-squint]}

  watch-theme
  {:doc "Watch src/ui/*.css and tokens.edn, rebuild theme on changes"
   :task (load-file "scripts/watch-theme.bb")}

  test
  {:doc "Run all unit tests"
   :requires ([clojure.test :as t]
              [ui.button-test]
              [ui.button-group-test]
              [ui.alert-test]
              [ui.badge-test]
              [ui.card-test]
              [ui.accordion-test]
              [ui.table-test]
              [ui.dialog-test]
              [ui.popover-test]
              [ui.command-test]
              [ui.spinner-test]
              [ui.empty-state-test]
              [ui.drop-zone-test]
              [ui.skeleton-test]
              [ui.progress-test]
              [ui.switch-test]
              [ui.tooltip-test]
              [ui.breadcrumb-test]
              [ui.pagination-test]
              [ui.form-test]
              [ui.select-test]
              [ui.icon-test]
              [ui.sidebar-test]
              [ui.chip-test]
              [ui.tag-input-test]
              [ui.separator-test]
              [ui.toolbar-test]
              [ui.tabs-test]
              [ui.calendar-test]
              [ui.calendar-events-test]
              [ui.player-bar-test]
              [ui.file-browser-test]
              [ui.file-progress-test]
              [ui.processing-bar-test]
              [ui.toast-test]
              [ui.camera-test]
              [ui.grid-test]
              [ui.theme-test]
              [ui.theme-toggle-test]
              [ui.chat-test]
              [ui.panels-test]
              [ui.hover-test])
   :task (let [{:keys [fail error]} (t/run-tests
                                      'ui.button-test
                                      'ui.button-group-test
                                      'ui.alert-test
                                      'ui.badge-test
                                      'ui.card-test
                                      'ui.accordion-test
                                      'ui.table-test
                                      'ui.dialog-test
                                      'ui.popover-test
                                      'ui.command-test
                                      'ui.spinner-test
                                      'ui.empty-state-test
                                      'ui.drop-zone-test
                                      'ui.skeleton-test
                                      'ui.progress-test
                                      'ui.switch-test
                                      'ui.tooltip-test
                                      'ui.breadcrumb-test
                                      'ui.pagination-test
                                      'ui.form-test
                                      'ui.select-test
                                      'ui.icon-test
                                      'ui.sidebar-test
                                      'ui.chip-test
                                      'ui.tag-input-test
                                      'ui.separator-test
                                      'ui.toolbar-test
                                      'ui.tabs-test
                                      'ui.calendar-test
                                      'ui.calendar-events-test
                                      'ui.player-bar-test
                                      'ui.file-browser-test
                                      'ui.file-progress-test
                                      'ui.processing-bar-test
                                      'ui.toast-test
                                      'ui.camera-test
                                      'ui.grid-test
                                      'ui.theme-test
                                      'ui.theme-toggle-test
                                      'ui.chat-test
                                      'ui.panels-test
                                      'ui.hover-test)]
           (when (pos? (+ fail error))
             (System/exit 1)))}

  ensure-npm
  {:doc "Install node_modules in dev/replicant and dev/squint if missing"
   :task (do
           (when-not (.exists (clojure.java.io/file "dev/replicant/node_modules"))
             (println "Installing node_modules in dev/replicant...")
             (shell {:dir "dev/replicant"} "npm install"))
           (when-not (.exists (clojure.java.io/file "dev/squint/node_modules"))
             (println "Installing node_modules in dev/squint...")
             (shell {:dir "dev/squint"} "npm install")))}

  dev-hiccup
  {:doc "Start hiccup dev server (--port PORT, default 3003)"
   :depends [build-theme]
   :requires ([dev.hiccup])
   :task (let [port (or (some-> (System/getenv "PORT") parse-long) 3003)]
           (dev.hiccup/start! {:port port})
           (deref (promise)))}

  serve
  {:doc "Production demo server — built assets, live reload disabled (PORT env, default 8080)"
   :depends [build-theme]
   :requires ([dev.hiccup]
              [clojure.java.io :as io])
   :task (do
           (when-not (.exists (io/file "dist/ui-runtime.js"))
             (io/make-parents "dist/ui-runtime.js")
             (io/copy (io/file "src/ui/ui-runtime.js") (io/file "dist/ui-runtime.js")))
           (let [port (or (some-> (System/getenv "PORT") parse-long) 8080)]
             (dev.hiccup/start! {:port port :live-reload? false})
             (deref (promise))))}

  dev-replicant
  {:doc "Start replicant dev server (PORT env var, default 3001)"
   :depends [build-theme ensure-npm]
   :task (let [port (some-> (System/getenv "PORT") parse-long)
               env (cond-> {} port (assoc "SHADOW_HTTP_PORT" (str port)))]
           (shell {:dir "dev/replicant" :extra-env env}
                  "npx" "shadow-cljs" "watch" "app"))}

  dev-squint
  {:doc "Start squint dev server (PORT env var, default 3002)"
   :depends [build-theme ensure-npm]
   :task (let [port (or (some-> (System/getenv "PORT") parse-long) 3002)]
           (shell {:dir "dev/squint"}
                  "bash" "-c" (str "npx squint watch & exec npx vite --port " port)))}

  dev
  {:doc "Start all dev servers in tmux"
   :depends [build-theme ensure-npm]
   :task (td/start dev-config)}

  dev:stop
  {:doc "Stop dev tmux session"
   :task (td/stop dev-config)}

  dev:restart
  {:doc "Restart all dev servers"
   :depends [build-theme ensure-npm]
   :task (td/restart dev-config)}

  dev:attach
  {:doc "Attach to dev tmux session"
   :task (td/attach dev-config)}

  dev:logs
  {:doc "Show recent dev server logs"
   :task (td/logs dev-config)}

  dev:status
  {:doc "Show dev server status"
   :task (td/status dev-config)}

  list-components
  {:doc "List all UI components and their public API"
   :requires ([tools.registry :as registry])
   :task (registry/print-components!)}

  list-icons
  {:doc "List all icons (* = dedicated filled variant)"
   :requires ([tools.registry :as registry])
   :task (registry/print-icons!)}

  gen-docs
  {:doc "Generate docs/components.md (component + icon listing)"
   :requires ([tools.registry :as registry])
   :task (registry/gen-docs!)}

  scan-consumers
  {:doc "Scan code dirs for projects depending on clj-ui-framework"
   :requires ([tools.consumers :as consumers])
   :task (consumers/scan! *command-line-args*)}

  sync-consumer-agents
  {:doc "Upsert the UI-framework section into consumers' AGENTS.md"
   :requires ([tools.consumers :as consumers])
   :task (consumers/sync-agents! *command-line-args*)}

  check-dev
  {:doc "Check all ui-dev tmux panes for errors and verify dev servers"
   :task (load-file "scripts/check-dev.bb")}

}}
